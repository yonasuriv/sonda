#!/bin/bash
export LC_ALL=C.UTF-8
export LANG=C.UTF-8

logo_sonda_script() {
    local version_text="SONDA v$(cat $VERSION_FILE 2>/dev/null || echo "unknown")"
    if command -v lolcat >/dev/null 2>&1; then
        echo -e "${LB}    $version_text" | lolcat
    else
        echo -e "${LB}${CYAN}    $version_text${RT}"
    fi
    echo -e ""
    echo -e "[i] This is a quick and lightweight system information. "
    echo -e "    For more detailed data, use the options '-s' for system information and '-n' for network details. "
    echo -e "    Type '-h' to see the full list of available commands."
}

logo_sonda_sysnet() {
    if command -v lolcat >/dev/null 2>&1; then
        bash $ASSETS/art/sonda_sysnet_1 | lolcat
    else
        bash $ASSETS/art/sonda_sysnet_1
    fi
}


