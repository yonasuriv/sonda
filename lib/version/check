#!/bin/bash

# Sonda Version Check Module
# This module is sourced by bin/init

# Variables
REPO_URL="https://raw.githubusercontent.com/yonasuriv/sonda/refs/heads/main/lib/version/current"
LOCAL_VERSION_FILE="$VERSION/current"

# Get the local version safely
get_local_version() {
    if [[ -f "$LOCAL_VERSION_FILE" ]]; then
        cat "$LOCAL_VERSION_FILE" 2>/dev/null | tr -d '\n\r ' || echo "unknown"
    else
        echo "unknown"
    fi
}

# Get the remote version safely
get_remote_version() {
    local remote_version=""
    
    if ! command -v curl &> /dev/null; then
        return 1
    fi
    
    remote_version=$(curl -s --connect-timeout 5 --max-time 10 "$REPO_URL" 2>/dev/null | tr -d '\n\r ' || echo "")
    
    if [[ -z "$remote_version" ]]; then
        return 1
    fi
    
    echo "$remote_version"
    return 0
}

# Legacy function for backward compatibility
check_versions() {
    local local_ver
    local remote_ver
    
    local_ver=$(get_local_version)
    if [[ "$local_ver" == "unknown" ]]; then
        echo -e "${E} Local version file not found.${RT}"
        return 1
    fi
    
    remote_ver=$(get_remote_version)
    if [[ -z "$remote_ver" ]]; then
        echo -e "${E} Failed to retrieve remote version.${RT}"
        return 1
    fi
    
    return 0
}

# Legacy function for backward compatibility
get_version() {
    local local_ver
    local remote_ver
    
    local_ver=$(get_local_version)
    remote_ver=$(get_remote_version)
    
    if [[ "$local_ver" == "unknown" ]] || [[ -z "$remote_ver" ]]; then
        check_versions
        return $?
    fi
    
    # Compare versions
    if [[ "$local_ver" == "$remote_ver" ]]; then
        echo -e "${S} ${BLUE}sonda version${RT} $local_ver ${GREEN2}(running the latest version)${RT}"
    else
        echo -e "${W} ${BLUE}sonda version${RT} ${YELLOW2} $local_ver${RT} (upgradable to ${CYAN2}$remote_ver${RT})"
    fi
}

# Legacy function for backward compatibility
get_update() {
    local local_ver
    local remote_ver
    
    local_ver=$(get_local_version)
    remote_ver=$(get_remote_version)
    
    if [[ "$local_ver" == "unknown" ]] || [[ -z "$remote_ver" ]]; then
        check_versions
        if [[ $? -ne 0 ]]; then
            return 1
        fi
        local_ver=$(get_local_version)
        remote_ver=$(get_remote_version)
    fi
    
    if [[ "$local_ver" == "$remote_ver" ]]; then
        echo -e "${S} ${BLUE}sonda version${RT} $local_ver ${GREEN2}(you are running the latest version)${RT}"
        return 0
    else
        echo -e "${W}  Updating..${LB}"
        
        if [[ ! -d "$INSTALLDIR/.git" ]]; then
            echo -e "${E} Installation directory is not a git repository.${RT}"
            return 1
        fi
        
        if ! command -v git &> /dev/null; then
            echo -e "${E} git not found. Cannot update.${RT}"
            return 1
        fi
        
        cd "$INSTALLDIR" || return 1
        git config --global --add safe.directory "$INSTALLDIR" 2>/dev/null || true
        git pull origin main &>/dev/null || {
            echo -e "${E} Upgrade failed. Please try again later.${RT}"
            return 1
        }
        
        local new_ver
        new_ver=$(get_local_version)
        if [[ "$new_ver" != "$local_ver" ]]; then
            echo -e "${S} sonda upgraded successfully from $local_ver to $new_ver${LB}"
            return 0
        else
            echo -e "${E} Upgrade failed. Please try again later or clear your GitHub cache.${RT}"
            return 1
        fi
    fi
}
