#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# export DH_VERBOSE = 1

# Version and package info
# When called from root: VERSION is at root
# When called from debian/: VERSION is at ../VERSION
VERSION := $(shell if [ -f VERSION ]; then cat VERSION; elif [ -f ../VERSION ]; then cat ../VERSION; else echo "1.8.5"; fi)
DEB_VERSION := $(VERSION)-1
PACKAGE_NAME := sonda_$(DEB_VERSION)_all.deb
# DIST_DIR is relative to project root
DIST_DIR := dist/sonda_$(DEB_VERSION)

# Standard debhelper targets
%:
	dh $@

# Custom targets for building and managing packages
# Note: 'build' and 'install' targets are debhelper targets - don't override them
# Use 'install-package' for installing the built .deb file
.PHONY: clean install-package package collect help uninstall

clean:
	@echo ""
	@echo "Cleaning build artifacts..."
	@echo ""
	rm -rf debian/sonda
	rm -rf debian/.debhelper
	rm -f debian/files
	rm -f debian/substvars
	rm -f debian/*.debhelper.log
	rm -f debian/*.substvars
	rm -f debian/*.debhelper
	rm -f debian/*.log
	@bash -c 'if [ -f $(PACKAGE_NAME) ]; then rm -f $(PACKAGE_NAME); fi'
	@bash -c 'if [ -f sonda_*.deb ]; then rm -f sonda_*.deb; fi'
	@bash -c 'if [ -f sonda_*.buildinfo ]; then rm -f sonda_*.buildinfo; fi'
	@bash -c 'if [ -f sonda_*.changes ]; then rm -f sonda_*.changes; fi'
	@bash -c 'if [ -f sonda_*.dsc ]; then rm -f sonda_*.dsc; fi'
	@bash -c 'if [ -f sonda_*.tar.* ]; then rm -f sonda_*.tar.*; fi'
	@echo ""
	@echo "Done."

collect:
	@echo ""
	@echo "Collecting build artifacts..."
	@mkdir -p $(DIST_DIR)
	@bash -c 'for deb in $(PACKAGE_NAME) ../$(PACKAGE_NAME) sonda_*.deb ../sonda_*.deb; do if [ -f "$$deb" ] 2>/dev/null; then cp -a "$$deb" $(DIST_DIR)/ 2>/dev/null && echo "Collected: $$deb" && break; fi; done'
	@bash -c 'for f in sonda_*_*.buildinfo ../sonda_*_*.buildinfo; do if ls $$f 2>/dev/null | head -1 | grep -q .; then cp -a $$f $(DIST_DIR)/ 2>/dev/null && break; fi; done'
	@bash -c 'for f in sonda_*_*.changes ../sonda_*_*.changes; do if ls $$f 2>/dev/null | head -1 | grep -q .; then cp -a $$f $(DIST_DIR)/ 2>/dev/null && break; fi; done'
	@bash -c 'for f in sonda_*.dsc ../sonda_*.dsc; do if [ -f "$$f" ] 2>/dev/null; then cp -a "$$f" $(DIST_DIR)/ 2>/dev/null && break; fi; done'
	@bash -c 'for f in sonda_*.tar.* ../sonda_*.tar.*; do if ls $$f 2>/dev/null | head -1 | grep -q .; then cp -a $$f $(DIST_DIR)/ 2>/dev/null && break; fi; done'
	@echo "Collected artifacts in $(DIST_DIR)"
	@echo ""

package:
	@echo "Package: $(PACKAGE_NAME)"
	@bash -c 'deb_file=$$(find $(DIST_DIR) -name "sonda_*.deb" -type f 2>/dev/null | head -1); if [ -n "$$deb_file" ]; then ls -lh "$$deb_file"; elif [ -f $(PACKAGE_NAME) ]; then ls -lh $(PACKAGE_NAME); elif [ -f ../$(PACKAGE_NAME) ]; then ls -lh ../$(PACKAGE_NAME); else echo "Package not found in $(DIST_DIR) or root. Run build first."; fi'

install-package:
	@echo ""
	@echo "Installing package..."
	@bash -c 'deb_file=$$(find $(DIST_DIR) -name "sonda_*.deb" -type f 2>/dev/null | head -1); if [ -z "$$deb_file" ]; then deb_file=$$(find .. -maxdepth 1 -name "sonda_$(DEB_VERSION)_all.deb" -type f 2>/dev/null | head -1); fi; if [ -n "$$deb_file" ]; then echo "Installing: $$deb_file"; sudo dpkg -i "$$deb_file" || (echo "Fixing dependencies..."; sudo apt-get install -f -y); else echo "Error: No .deb package found in $(DIST_DIR) or parent directory"; exit 1; fi'
	@echo "Installation complete!"
	@echo ""

uninstall:
	@echo "Uninstalling package..."
	sudo dpkg -r sonda
	@echo "Uninstallation complete!"

help:
	@echo "Sonda Debian Package Build System"
	@echo ""
	@echo "Available targets:"
	@echo "  make -f debian/rules clean         - Clean build artifacts"
	@echo "  make -f debian/rules collect       - Collect build artifacts to dist/"
	@echo "  make -f debian/rules package       - Show package info from dist/"
	@echo "  make -f debian/rules install-package - Install the package from dist/"
	@echo "  make -f debian/rules uninstall      - Uninstall the package"
	@echo "  make -f debian/rules help           - Show this help message"
	@echo ""
	@echo "Note: Use 'dpkg-buildpackage -us -uc -b' or './deb.sh build' to build"
	@echo ""
	@echo "Manual installation:"
	@echo "  sudo dpkg -i dist/sonda_*/sonda_*.deb"
	@echo "  sudo apt-get install -f  # Install dependencies if needed"

# Debhelper overrides
override_dh_auto_install:
	# Install files to debian/sonda/usr/share/sonda
	mkdir -p debian/sonda/usr/share/sonda
	# Install main binary directory
	cp -r src/bin debian/sonda/usr/share/sonda/
	# Install shared lib/core directory
	cp -r src/lib debian/sonda/usr/share/sonda/
	# Install modes (check, audit, etc.)
	cp -r src/modes debian/sonda/usr/share/sonda/
	# Install shared assets
	cp -r assets debian/sonda/usr/share/sonda/
	# Install binary to /usr/bin
	mkdir -p debian/sonda/usr/bin
	cp src/bin/sonda debian/sonda/usr/bin/
	chmod +x debian/sonda/usr/bin/sonda
	chmod +x debian/sonda/usr/share/sonda/modes/scan/scan-cli.sh
	chmod +x debian/sonda/usr/share/sonda/modes/audit/audit-cli.sh
	chmod +x debian/sonda/usr/share/sonda/modes/audit/modules/boot/init.sh
	chmod +x debian/sonda/usr/share/sonda/modes/audit/modules/security/init.sh
	# Make all helper scripts executable
	find debian/sonda/usr/share/sonda/modes -name "*.sh" -type f -exec chmod +x {} \;
	# Install desktop file
	mkdir -p debian/sonda/usr/share/applications
	cp assets/shortcuts/sonda.desktop debian/sonda/usr/share/applications/
	# Install icon
	mkdir -p debian/sonda/usr/share/pixmaps
	cp assets/icons/sonda.png debian/sonda/usr/share/pixmaps/
	# Install version file to root of installation (uppercase VERSION to match code expectations)
	cp VERSION debian/sonda/usr/share/sonda/VERSION

# No Python package to process - all Python deps are in Depends

override_dh_auto_build:
	# No build step needed for bash scripts
	@echo "No build step required"
