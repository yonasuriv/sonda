#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# export DH_VERBOSE = 1

# Version and package info
# When called from root: VERSION is at root
# When called from debian/: VERSION is at ../VERSION
VERSION := $(shell if [ -f VERSION ]; then cat VERSION; elif [ -f ../VERSION ]; then cat ../VERSION; else echo "1.8.5"; fi)
DEB_VERSION := $(VERSION)-1
PACKAGE_NAME := sonda_$(DEB_VERSION)_all.deb
# DIST_DIR is relative to project root
DIST_DIR := dist/sonda_$(DEB_VERSION)

# Standard debhelper targets
%:
	dh $@

# Custom targets for building and managing packages
# Note: 'build' target is NOT here - dpkg-buildpackage handles that
.PHONY: clean install package collect help uninstall

clean:
	@echo ""
	@echo "Cleaning build artifacts..."
	@echo ""
	rm -rf debian/sonda
	rm -rf debian/.debhelper
	rm -f debian/files
	rm -f debian/substvars
	rm -f debian/*.debhelper.log
	rm -f debian/*.substvars
	rm -f debian/*.debhelper
	rm -f debian/*.log
	@bash -c 'if [ -f $(PACKAGE_NAME) ]; then rm -f $(PACKAGE_NAME); fi'
	@bash -c 'if [ -f sonda_*.deb ]; then rm -f sonda_*.deb; fi'
	@bash -c 'if [ -f sonda_*.buildinfo ]; then rm -f sonda_*.buildinfo; fi'
	@bash -c 'if [ -f sonda_*.changes ]; then rm -f sonda_*.changes; fi'
	@bash -c 'if [ -f sonda_*.dsc ]; then rm -f sonda_*.dsc; fi'
	@bash -c 'if [ -f sonda_*.tar.* ]; then rm -f sonda_*.tar.*; fi'
	@echo ""
	@echo "Done."

collect:
	@echo ""
	@echo "Collecting build artifacts..."
	@mkdir -p $(DIST_DIR)
	@bash -c 'if [ -f $(PACKAGE_NAME) ]; then cp -a $(PACKAGE_NAME) $(DIST_DIR)/; fi'
	@bash -c 'if ls sonda_$(DEB_VERSION)_*.buildinfo 2>/dev/null | head -1 | grep -q .; then cp -a sonda_$(DEB_VERSION)_*.buildinfo $(DIST_DIR)/ 2>/dev/null || true; fi'
	@bash -c 'if ls sonda_$(DEB_VERSION)_*.changes 2>/dev/null | head -1 | grep -q .; then cp -a sonda_$(DEB_VERSION)_*.changes $(DIST_DIR)/ 2>/dev/null || true; fi'
	@bash -c 'if [ -f sonda_$(DEB_VERSION).dsc ]; then cp -a sonda_$(DEB_VERSION).dsc $(DIST_DIR)/ 2>/dev/null || true; fi'
	@bash -c 'if ls sonda_$(DEB_VERSION).tar.* 2>/dev/null | head -1 | grep -q .; then cp -a sonda_$(DEB_VERSION).tar.* $(DIST_DIR)/ 2>/dev/null || true; fi'
	@echo "Collected artifacts in $(DIST_DIR)"
	@echo ""

package:
	@echo "Package: $(PACKAGE_NAME)"
	@bash -c 'if [ -f $(DIST_DIR)/$(PACKAGE_NAME) ]; then ls -lh $(DIST_DIR)/$(PACKAGE_NAME); elif [ -f $(PACKAGE_NAME) ]; then ls -lh $(PACKAGE_NAME); else echo "Package not found in $(DIST_DIR) or root. Run build first."; fi'

install: package
	@echo ""
	@echo "Installing package..."
	@bash -c 'if [ -f $(DIST_DIR)/$(PACKAGE_NAME) ]; then sudo dpkg -i $(DIST_DIR)/$(PACKAGE_NAME); else echo "Error: Package $(PACKAGE_NAME) not found in $(DIST_DIR)"; exit 1; fi'
	@echo "Installation complete!"
	@echo ""

uninstall:
	@echo "Uninstalling package..."
	sudo dpkg -r sonda
	@echo "Uninstallation complete!"

help:
	@echo "Sonda Debian Package Build System"
	@echo ""
	@echo "Available targets:"
	@echo "  make -f debian/rules clean      - Clean build artifacts"
	@echo "  make -f debian/rules collect    - Collect build artifacts to dist/"
	@echo "  make -f debian/rules package    - Show package info from dist/"
	@echo "  make -f debian/rules install    - Install the package from dist/"
	@echo "  make -f debian/rules uninstall  - Uninstall the package"
	@echo "  make -f debian/rules help        - Show this help message"
	@echo ""
	@echo "Note: Use 'dpkg-buildpackage -us -uc -b' or './deb.sh build' to build"
	@echo ""
	@echo "Manual installation:"
	@echo "  sudo dpkg -i dist/sonda_*/sonda_*.deb"
	@echo "  sudo apt-get install -f  # Install dependencies if needed"

# Debhelper overrides
override_dh_auto_install:
	# Install files to debian/sonda/usr/share/sonda
	mkdir -p debian/sonda/usr/share/sonda
	cp -r src/bin src/lib src/modules assets debian/sonda/usr/share/sonda/
	# Install binary to /usr/bin
	mkdir -p debian/sonda/usr/bin
	cp src/bin/sonda debian/sonda/usr/bin/
	chmod +x debian/sonda/usr/bin/sonda
	# Install desktop file
	mkdir -p debian/sonda/usr/share/applications
	cp assets/shortcuts/sonda.desktop debian/sonda/usr/share/applications/
	# Install icon
	mkdir -p debian/sonda/usr/share/pixmaps
	cp assets/icons/sonda.png debian/sonda/usr/share/pixmaps/
	# Install version file to root of installation
	cp VERSION debian/sonda/usr/share/sonda/version

# No Python package to process - all Python deps are in Depends

override_dh_auto_build:
	# No build step needed for bash scripts
	@echo "No build step required"
