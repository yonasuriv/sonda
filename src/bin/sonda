#!/bin/bash

# Sonda - System Information Tool
# Main binary entry point

# Enable strict error handling, but allow functions to handle their own errors
set -uo pipefail
# Note: We don't use 'set -e' globally because some system info commands may fail
# (e.g., reading optional system files), and we want to handle those gracefully

# Get user's home directory (handles sudo scenarios)
if [[ "$EUID" -eq 0 ]] && [[ -n "${SUDO_USER:-}" ]]; then
    HOMEUSER=$(eval echo "~$SUDO_USER")
else
    HOMEUSER="${HOME:-$HOME}"
fi

# Determine installation directory
# Priority: 1. Environment variable, 2. System-wide (/usr/share/sonda), 3. Source directory, 4. User local
if [[ -n "${SONDA_INSTALL_DIR:-}" ]]; then
    INSTALLDIR="$SONDA_INSTALL_DIR"
elif [[ -d "/usr/share/sonda" ]] && [[ -f "/usr/share/sonda/modes/check/lib/style" ]]; then
    # System-wide installation (Debian package)
    INSTALLDIR="/usr/share/sonda"
elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/../modes/check/lib/style" ]] || [[ -f "$(dirname "${BASH_SOURCE[0]}")/../lib/core/style" ]]; then
    # Running from source directory
    INSTALLDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    # VERSION file is at project root, not in src/
    if [[ -f "$(dirname "$INSTALLDIR")/VERSION" ]]; then
        export VERSION_FILE="$(cd "$(dirname "$INSTALLDIR")" && pwd)/VERSION"
    fi
else
    # Fallback to user local (legacy)
    INSTALLDIR="$HOMEUSER/.local/share/sonda"
fi

# Initialize logging early - define fallback functions first
log_error() { echo "[ERROR] $*" >&2; }
log_warn() { echo "[WARN] $*" >&2; }
log_info() { :; }
log_debug() { :; }

# Try to source actual logger if available
if [[ -f "$INSTALLDIR/modes/check/lib/logger" ]]; then
    source "$INSTALLDIR/modes/check/lib/logger" 2>/dev/null || true
elif [[ -f "$INSTALLDIR/check/lib/logger" ]]; then
    # Fallback for old structure
    source "$INSTALLDIR/check/lib/logger" 2>/dev/null || true
fi

# Check if installation directory exists
if [[ ! -d "$INSTALLDIR" ]]; then
    echo "Error: Sonda is not installed or installation directory not found: $INSTALLDIR" >&2
    echo "Please run: sudo ./SETUP.sh --install" >&2
    exit 1
fi

# Script initialization - export variables
set -a

# CORE PATHS (exported for use by mode scripts)
export INSTALLDIR
export HOMEUSER

# Version file is now in root directory (set above if from source, otherwise here)
if [[ -z "${VERSION_FILE:-}" ]]; then
    export VERSION_FILE="$INSTALLDIR/version"
fi

# ASSETS (shared across modes)
export ASSETS="$INSTALLDIR/assets"

# MODE PATHS (defined once, reused)
export MODES_DIR="$INSTALLDIR/modes"
export CHECK_MODE_DIR="$MODES_DIR/check"
export AUDIT_MODE_DIR="$MODES_DIR/audit"
export SHARED_LIB_DIR="$INSTALLDIR/lib"
export SHARED_CORE_DIR="$SHARED_LIB_DIR/core"

# Mode script paths
export CHECK_CLI="$CHECK_MODE_DIR/cli.sh"
export AUDIT_CLI="$AUDIT_MODE_DIR/cli.sh"

# Log initialization
log_info "Sonda started with arguments: $*"

# Improved log file location (using XDG standard)
export LOGFILE_DIR="$HOMEUSER/.logs/sonda"
mkdir -p "$LOGFILE_DIR" 2>/dev/null || true
export LOGFILE="$LOGFILE_DIR/system_$(date +%Y%m%d_%H%M%S).log"

set +a

# Determine mode (default to check for now)
MODE="${1:-check}"

# Route to appropriate mode script
# Use source instead of exec to preserve functions and variables
# Shift mode argument so it's not passed to the mode script
case "$MODE" in
    check|"")
        # Default mode: check - pass all arguments (including empty)
        if [[ -f "$CHECK_CLI" ]]; then
            source "$CHECK_CLI" "$@"
            exit $?
        else
            echo "Error: Check mode script not found: $CHECK_CLI" >&2
            log_error "Check mode script not found"
            exit 1
        fi
        ;;
    audit)
        # Audit mode - shift "audit" argument before passing to script
        shift
        if [[ -f "$AUDIT_CLI" ]]; then
            source "$AUDIT_CLI" "$@"
            exit $?
        else
            echo "Error: Audit mode script not found: $AUDIT_CLI" >&2
            log_error "Audit mode script not found"
            exit 1
        fi
        ;;
    *)
        # Unknown mode, try check mode with all arguments
        if [[ -f "$CHECK_CLI" ]]; then
            source "$CHECK_CLI" "$@"
            exit $?
        else
            echo "Error: Unknown mode and check mode not available" >&2
            exit 1
        fi
        ;;
esac
