#!/bin/bash

# Sonda - System Information Tool
# Main binary entry point

# Enable strict error handling, but allow functions to handle their own errors
set -uo pipefail
# Note: We don't use 'set -e' globally because some system info commands may fail
# (e.g., reading optional system files), and we want to handle those gracefully

# Get user's home directory (handles sudo scenarios)
if [[ "$EUID" -eq 0 ]] && [[ -n "${SUDO_USER:-}" ]]; then
    HOMEUSER=$(eval echo "~$SUDO_USER")
else
    HOMEUSER="${HOME:-$HOME}"
fi

# meta: bash. purpose=find-config-recursive. version=1
#ROOT_DIR="$PWD/src"; find "$ROOT_DIR" -type f -name 'sonda.conf' -print
SONDA_CONFIG_NAME="config.sh"

# Resolve the real script location (handles symlinks, PATH execution)
_script_path="$(realpath -e -- "${BASH_SOURCE[0]}")"
_script_dir="$(dirname -- "$_script_path")"

# Determine installation directory or if it was run as a binary and source the config file
case "$_script_dir" in
  /usr/bin|/usr/sbin|/bin|/sbin)
     INSTALL_DIR="/usr/share/sonda"
     # When installed: lib/core/config.sh (no src/ prefix)
     CFG_FILE="$INSTALL_DIR/lib/core/$SONDA_CONFIG_NAME"
    ;;
    "$HOME/.local/bin"|"$HOME/.local/sbin")
     INSTALL_DIR="$HOME/.local/share/sonda"
     # When installed: lib/core/config.sh (no src/ prefix)
     CFG_FILE="$INSTALL_DIR/lib/core/$SONDA_CONFIG_NAME"
    ;;
  *)
    # Fallback - running from source
    _script_dir="$(realpath -e -- "$(dirname -- "$_script_path")/../..")"
    INSTALL_DIR="$_script_dir"
    # When running from source: src/lib/core/config.sh (with src/ prefix)
    CFG_FILE="$INSTALL_DIR/src/lib/core/$SONDA_CONFIG_NAME"
    ;;
esac

# Initialize logging early - define fallback functions first
log_debug() { :; }
log_error() { echo -e "${RED}[ERROR]${RT} $*" >&2; }
log_warn()  { echo -e "${YELLOW}[WARN]${RT} $*" >&2; }
log_info()  { :; }

# Source config file
if [[ -r "${CFG_FILE:-}" ]]; then
  # shellcheck disable=SC1090
  source "$CFG_FILE" 
else
  printf 'Sonda config file not found or not readable: %s\n' "${CFG_FILE:-}" >&2
  exit 2
fi

# Script initialization - export variables
set -a

# Export INSTALL_DIR before calling load_sonda_config
export INSTALL_DIR
export HOMEUSER

# Load config to get all variables including STYLE_FILE
if [[ "$(type -t load_sonda_config)" == "function" ]]; then
    load_sonda_config
else
    log_error "load_sonda_config function not found in $CFG_FILE"
    exit 1
fi

# Source style file after config is loaded
if [[ -r "${STYLE_FILE:-}" ]]; then
  # shellcheck disable=SC1090
  source "$STYLE_FILE" 
else
  printf 'Sonda style file not found or not readable: %s\n' "${STYLE_FILE:-}" >&2
  exit 2
fi

# Source banner functions
if [[ -r "${BANNER_FILE:-}" ]]; then
  # shellcheck disable=SC1090
  source "${BANNER_FILE}"
fi

# Source updater functions
if [[ -r "${UTILS_DIR:-}/updater.sh" ]]; then
  # shellcheck disable=SC1090
  source "${UTILS_DIR}/updater.sh"
fi

set +a

# Parse command line arguments for mode selection
MODE=""  # No mode set initially
ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        scan|check|info)
            MODE="check"
            shift
            ;;
        audit)
            MODE="audit"
            shift
            ;;
        help)
            # Handle 'help' command with optional topic
            if type logo_sonda_sysnet &>/dev/null; then
                logo_sonda_sysnet
            fi
            if [[ -f "${PRINT_HELP:-}" ]]; then
                # If there's a next argument, use it as the topic, otherwise default to main
                help_topic="${2:-main}"
                bash "$PRINT_HELP" "$help_topic"
                # Consume the topic argument if it exists
                [[ -n "${2:-}" ]] && shift
            else
                echo "Help system not available" >&2
            fi
            exit 0
            ;;
        -v|--version)
            log_info "Checking version (--version)"
            get_version
            exit 0
            ;;
            
        --update)
            log_info "Checking for updates (--update)"
            echo ""
            get_update
            exit_code=$?
            echo ""
            exit $exit_code
            ;;
        
        --upgrade)
            log_info "Updating Sonda (--upgrade)"
            perform_upgrade
            exit $?
            ;;
        
        --recommends)
            log_info "Showing system recommendations (--recommends)"
            # system_recommended is in lib/logic (already sourced)
            if ! type system_recommended &>/dev/null; then
                echo -e "${E} system_recommended function not found in lib/logic.${RT}" >&2
                log_error "system_recommended function not found"
                exit 1
            fi
            
            if ! command -v inxi &>/dev/null; then
                echo -e "${E} inxi not found. Please install it: ${CYAN}sudo apt install inxi${RT}" >&2
                log_error "inxi command not found"
                exit 1
            fi
            
            if type system_recommended &>/dev/null; then
                system_recommended 2>&1 || {
                    local exit_code=$?
                    if [[ $exit_code -ne 0 ]]; then
                        echo -e "${W} System recommendations check completed with warnings.${RT}" >&2
                        log_warn "system_recommended exited with code $exit_code"
                    fi
                }
            else
                echo -e "${E} system_recommended function not available.${RT}" >&2
                log_error "system_recommended function not found after sourcing"
                exit 1
            fi
            exit 0
            ;;

        -h|--help)
            # If a mode was already set, pass help to that mode
            # Otherwise show main help
            if [[ -n "$MODE" ]]; then
                # Pass help to the mode script
                ARGS+=("$1")
                shift
            else
                # Show main help
                if type logo_sonda_sysnet &>/dev/null; then
                    logo_sonda_sysnet
                fi
                if [[ -f "${PRINT_HELP:-}" ]]; then
                    bash "$PRINT_HELP" main
                else
                    echo "Help system not available" >&2
                fi
                exit 0
            fi
            ;;
        *)
            # Not a mode flag, add to args
            ARGS+=("$1")
            shift
            ;;
    esac
done

# Route to appropriate mode script
# Use source instead of exec to preserve functions and variables
case "$MODE" in
    check)
        # Check mode
        if [[ -f "${SCAN_CLI:-}" ]]; then
            source "$SCAN_CLI" "${ARGS[@]}"
            exit $?
        else
            echo "Error: Check mode script not found: ${SCAN_CLI:-}" >&2
            log_error "Check mode script not found"
            exit 1
        fi
        ;;
    audit)
        # Audit mode
        if [[ -f "${AUDIT_CLI:-}" ]]; then
            source "$AUDIT_CLI" "${ARGS[@]}"
            exit $?
        else
            echo "Error: Audit mode script not found: ${AUDIT_CLI:-}" >&2
            log_error "Audit mode script not found"
            exit 1
        fi
        ;;

    *)
        # Unknown mode, default to check
        MODE="check"
        if [[ -f "${SCAN_CLI:-}" ]]; then
            source "$SCAN_CLI" "${ARGS[@]}"
            exit $?
        else
            echo "Error: Check mode not available" >&2
            exit 1
        fi
        ;;
esac
