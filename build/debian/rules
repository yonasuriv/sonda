#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# export DH_VERBOSE = 1

RULES_PATH := $(lastword $(MAKEFILE_LIST))
RULES_DIR := $(patsubst %/,%,$(dir $(RULES_PATH)))
ifeq ($(RULES_DIR),.)
DEBIAN_DIR := debian
else
DEBIAN_DIR := $(RULES_DIR)
endif

# Version and package info. dpkg-buildpackage takes the package version from
# the Debian changelog, so helper targets use the same source to avoid mismatched
# artifact names when VERSION and the changelog are temporarily out of sync.
DEB_VERSION := $(shell dpkg-parsechangelog -l$(DEBIAN_DIR)/changelog -S Version 2>/dev/null || echo "1.8.5-1")
PACKAGE_NAME := sonda_$(DEB_VERSION)_all.deb
# DIST_DIR is relative to project root
DIST_DIR := dist/sonda_$(DEB_VERSION)
BUILD_ROOT := .build

# Standard debhelper targets
%:
	dh $@

# Custom targets for building and managing packages
# Note: 'build' and 'install' targets are debhelper targets - don't override them
# Use 'install-package' for installing the built .deb file
.PHONY: clean build-package install-package package collect help uninstall

clean:
	@echo ""
	@echo "Cleaning build artifacts..."
	@echo ""
	rm -rf $(DEBIAN_DIR)/sonda
	rm -rf $(DEBIAN_DIR)/.debhelper
	rm -f $(DEBIAN_DIR)/files
	rm -f $(DEBIAN_DIR)/substvars
	rm -f $(DEBIAN_DIR)/*.debhelper.log
	rm -f $(DEBIAN_DIR)/*.substvars
	rm -f $(DEBIAN_DIR)/*.debhelper
	rm -f $(DEBIAN_DIR)/*.log
	rm -f $(DEBIAN_DIR)/debhelper-build-stamp
	rm -rf $(BUILD_ROOT)
	@bash -c 'if [ -f $(PACKAGE_NAME) ]; then rm -f $(PACKAGE_NAME); fi'
	@bash -c 'if [ -f sonda_*.deb ]; then rm -f sonda_*.deb; fi'
	@bash -c 'if [ -f sonda_*.buildinfo ]; then rm -f sonda_*.buildinfo; fi'
	@bash -c 'if [ -f sonda_*.changes ]; then rm -f sonda_*.changes; fi'
	@bash -c 'if [ -f sonda_*.dsc ]; then rm -f sonda_*.dsc; fi'
	@bash -c 'if [ -f sonda_*.tar.* ]; then rm -f sonda_*.tar.*; fi'
	@echo ""
	@echo "Done."

collect:
	@echo ""
	@echo "Collecting build artifacts..."
	@mkdir -p $(DIST_DIR)
	@bash -c 'for deb in dist/sonda_*.deb $(BUILD_ROOT)/sonda_*.deb sonda_*.deb; do if [ -f "$$deb" ] 2>/dev/null; then cp -a "$$deb" $(DIST_DIR)/ 2>/dev/null && echo "Collected: $$deb" && break; fi; done'
	@bash -c 'for f in dist/sonda_*_*.buildinfo $(BUILD_ROOT)/sonda_*_*.buildinfo sonda_*_*.buildinfo; do if ls $$f 2>/dev/null | head -1 | grep -q .; then cp -a $$f $(DIST_DIR)/ 2>/dev/null && break; fi; done'
	@bash -c 'for f in dist/sonda_*_*.changes $(BUILD_ROOT)/sonda_*_*.changes sonda_*_*.changes; do if ls $$f 2>/dev/null | head -1 | grep -q .; then cp -a $$f $(DIST_DIR)/ 2>/dev/null && break; fi; done'
	@echo "Collected artifacts in $(DIST_DIR)"
	@echo ""

build-package:
	@./scripts/install_debian.sh build

package:
	@echo "Package: $(PACKAGE_NAME)"
	@bash -c 'deb_file=$$(find $(DIST_DIR) dist -name "sonda_*.deb" -type f 2>/dev/null | sort | tail -1); if [ -n "$$deb_file" ]; then ls -lh "$$deb_file"; elif [ -f $(PACKAGE_NAME) ]; then ls -lh $(PACKAGE_NAME); else echo "Package not found in dist/. Run build first."; fi'

install-package:
	@echo ""
	@echo "Installing package..."
	@bash -c 'deb_file=$$(find $(DIST_DIR) dist -name "sonda_*.deb" -type f 2>/dev/null | sort | tail -1); if [ -n "$$deb_file" ]; then echo "Installing: $$deb_file"; sudo apt-get install -y "$$(realpath "$$deb_file")"; else echo "Error: No .deb package found in dist/. Run build first."; exit 1; fi'
	@echo "Installation complete!"
	@echo ""

uninstall:
	@echo "Uninstalling package..."
	sudo dpkg -r sonda
	@echo "Uninstallation complete!"

help:
	@echo "Sonda Debian Package Build System"
	@echo ""
	@echo "Available targets:"
	@echo "  make -f build/debian/rules clean         - Clean build artifacts"
	@echo "  make -f build/debian/rules build-package - Build inside .build/ and collect to dist/"
	@echo "  make -f build/debian/rules collect       - Collect build artifacts to dist/"
	@echo "  make -f build/debian/rules package       - Show package info from dist/"
	@echo "  make -f build/debian/rules install-package - Install the package from dist/"
	@echo "  make -f build/debian/rules uninstall      - Uninstall the package"
	@echo "  make -f build/debian/rules help           - Show this help message"
	@echo ""
	@echo "Note: Use './install.sh source -d debian' or 'make -f build/debian/rules build-package' to build"
	@echo ""
	@echo "Manual installation:"
	@echo "  sudo apt-get install ./dist/sonda_*/sonda_*.deb"

# Debhelper overrides
override_dh_auto_install:
	# Install files to debian/sonda/usr/share/sonda
	mkdir -p debian/sonda/usr/share/sonda
	# Install main binary directory
	cp -r src/bin debian/sonda/usr/share/sonda/
	# Install shared lib/core directory
	cp -r src/lib debian/sonda/usr/share/sonda/
	# Install modes (check, audit, etc.)
	cp -r src/modes debian/sonda/usr/share/sonda/
	# Install shared assets
	cp -r assets debian/sonda/usr/share/sonda/
	# Install binary to /usr/bin
	mkdir -p debian/sonda/usr/bin
	cp src/bin/sonda debian/sonda/usr/bin/
	chmod +x debian/sonda/usr/bin/sonda
	chmod +x debian/sonda/usr/share/sonda/modes/scan/scan-cli.sh
	chmod +x debian/sonda/usr/share/sonda/modes/audit/audit-cli.sh
	chmod +x debian/sonda/usr/share/sonda/modes/audit/modules/boot/init.sh
	chmod +x debian/sonda/usr/share/sonda/modes/audit/modules/security/init.sh
	# Make all helper scripts executable
	find debian/sonda/usr/share/sonda/modes -name "*.sh" -type f -exec chmod +x {} \;
	# Install desktop file
	mkdir -p debian/sonda/usr/share/applications
	cp assets/shortcuts/sonda.desktop debian/sonda/usr/share/applications/
	# Install icon
	mkdir -p debian/sonda/usr/share/pixmaps
	cp assets/icons/sonda.png debian/sonda/usr/share/pixmaps/
	# Install version file to root of installation (uppercase VERSION to match code expectations)
	cp VERSION debian/sonda/usr/share/sonda/VERSION

# No Python package to process - all Python deps are in Depends

override_dh_auto_build:
	# No build step needed for bash scripts
	@echo "No build step required"
